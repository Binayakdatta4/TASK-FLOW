{
  "entities": {
    "Task": {
      "title": "Task",
      "description": "A user-owned to-do task item in TaskFlow.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "Short task title.",
          "minLength": 1,
          "maxLength": 140
        },
        "description": {
          "type": "string",
          "description": "Optional detailed task description.",
          "maxLength": 1000
        },
        "priority": {
          "type": "string",
          "description": "Task urgency level.",
          "enum": ["Low", "Medium", "High"]
        },
        "dueDate": {
          "type": "string",
          "description": "Optional ISO date string (YYYY-MM-DD) or empty string.",
          "maxLength": 10,
          "pattern": "^(\\d{4}-\\d{2}-\\d{2})?$"
        },
        "completed": {
          "type": "boolean",
          "description": "Whether the task has been completed."
        },
        "userId": {
          "type": "string",
          "description": "Firebase Auth UID of the task owner.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the task was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the task was last modified."
        }
      },
      "required": ["title", "description", "priority", "dueDate", "completed", "userId", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/tasks/{taskId}": {
      "schema": { "$ref": "#/entities/Task" },
      "description": "Top-level tasks collection partitioned per authenticated owner via userId."
    }
  }
}
