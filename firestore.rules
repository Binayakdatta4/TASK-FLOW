rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny all unmatched paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Reusable Hardened Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(data) {
      return isVerifiedUser() && data.userId == request.auth.uid;
    }

    // Validation Blueprint for Task Entity
    function isValidTask(data) {
      return data.keys().hasAll([
        'title',
        'description',
        'priority',
        'dueDate',
        'completed',
        'userId',
        'createdAt',
        'updatedAt'
      ])
      && data.keys().hasOnly([
        'title',
        'description',
        'priority',
        'dueDate',
        'completed',
        'userId',
        'createdAt',
        'updatedAt'
      ])
      && data.title is string
      && data.title.size() >= 1
      && data.title.size() <= 140
      && data.description is string
      && data.description.size() <= 1000
      && data.priority is string
      && data.priority in ['Low', 'Medium', 'High']
      && data.dueDate is string
      && data.dueDate.size() <= 10
      && data.dueDate.matches('^(\\d{4}-\\d{2}-\\d{2})?$')
      && data.completed is bool
      && data.userId is string
      && isValidId(data.userId)
      && data.userId == request.auth.uid
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    match /tasks/{taskId} {
      // Single-document read restricted strictly to verified owner
      allow get: if isValidId(taskId) && isOwner(existing());

      // Query list strictly enforces owner filter against resource.data
      allow list: if isVerifiedUser() && existing().userId == request.auth.uid;

      // Create enforces verified auth, path ID hardening, full schema blueprint, initial state, and server timestamps
      allow create: if isVerifiedUser()
        && isValidId(taskId)
        && isValidTask(incoming())
        && incoming().completed == false
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      // Action-based Update wrapped in full schema validation and immutable field locks
      allow update: if isVerifiedUser()
        && isValidId(taskId)
        && isValidTask(incoming())
        && isOwner(existing())
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action 1: Toggle completion status
          incoming().diff(existing()).affectedKeys().hasOnly(['completed', 'updatedAt'])
          ||
          // Action 2: Edit task details
          incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'priority', 'dueDate', 'updatedAt'])
        );

      // Delete restricted strictly to verified owner with valid document ID
      allow delete: if isValidId(taskId) && isOwner(existing());
    }
  }
}
